# ==============================================================================
# DEEP-BROWSER DESKTOP — RUNTIME ENVIRONMENT
# ==============================================================================
# Copy this file to .env and configure your keys.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# --- Primary AI Provider: Google Gemini ---
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Desktop Hotkeys & Flags ---
# Set to 1 only if you wish to force the initial setup wizard on startup
DEEP_BROWSER_FORCE_ONBOARDING=0

# --- macOS / Windows Release Signing (See docs/ for CI signing config) ---
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)
