{
  "manifest_version": 3,
  "name": "Deep-Browser AI Copilot",
  "version": "0.3.0",
  "description": "Browser-Use Autonomous AI Copilot for Chrome — Backend-Unified Architecture",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:7788/*",
    "http://127.0.0.1:7788/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Deep-Browser AI Copilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/cdp_executor.js",
        "content/chess_bridge.js",
        "content/hud_overlay.js",
        "content/agent_cursor.js",
        "content/floating_hud.js"
      ],
      "css": ["content/hud_overlay.css", "content/agent_cursor.css", "content/floating_hud.css"],
      "run_at": "document_end"
    }
  ]

}
