{
  "manifest_version": 3,
  "name": "Deep-Browser AI Copilot",
  "version": "0.2.0",
  "description": "Standalone Browser-Use Autonomous AI Copilot for Chrome",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Deep-Browser AI Copilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hud_overlay.js"],
      "css": ["content/hud_overlay.css"],
      "run_at": "document_end"
    }
  ]
}
