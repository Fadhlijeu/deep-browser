{
  "manifest_version": 3,
  "name": "Deep-Browser Co-Pilot",
  "version": "0.1.0",
  "description": "Local-First Browser Agent Workstation SidePanel & HUD Co-Pilot",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Deep-Browser Co-Pilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hud_overlay.js"],
      "css": ["content/hud_overlay.css"],
      "run_at": "document_end"
    }
  ]
}
