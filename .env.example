# ==============================================================================
# DEEP-BROWSER — RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your keys.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# --- Primary AI Provider: Google Gemini ---
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Default Gemini model used for agent planning and execution
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Deep-Browser Companion Bridge Configuration ---
DEEP_BROWSER_HOST=127.0.0.1
DEEP_BROWSER_PORT=8765

# --- Browser & Agent Safety Settings ---
DEEP_BROWSER_SAFE_MODE=true
DEEP_BROWSER_CONFIRMATION_TIMEOUT=60

# --- Optional Alternative Providers ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
